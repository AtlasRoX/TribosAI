# Normalise line endings: text files are stored with LF and checked out with LF on every platform, so Windows
# checkouts produce no LF->CRLF warnings and the Docker images and shell scripts keep LF.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never normalised or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.tif binary
*.tiff binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
