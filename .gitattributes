*.h5 binary
*.hdf5 binary
*.h5ad binary
*.mat binary
*.parquet binary
*.xlsx binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.npy binary
*.npz binary
*.pkl binary
*.pt binary
*.onnx binary
