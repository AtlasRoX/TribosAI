# Tribos environment template, generated by scripts/gen_env_reference.py (see docs/configuration.md).
# Copy to .env and uncomment what you need. Every line shows the default; secrets are left blank.
# Never commit a filled-in .env.

# --- State directories ---
# Directories (os.pathsep-separated) that typed dataset paths may point into; <cwd>/data when unset.
# TRIBOS_DATASET_ROOTS=
# One data root (`~` expanded): memory/, runs/, uploads/, jobs/, tool_cache/ default under it.
# TRIBOS_DATA_DIR=
# Background-job SQLite store directory (wins over TRIBOS_RUNS_DIR/jobs).
# TRIBOS_JOBS_DIR=
# Research memory vault directory (wins over TRIBOS_DATA_DIR); also the projects store fallback.
# TRIBOS_MEMORY_DIR=
# Projects store directory (wins over TRIBOS_MEMORY_DIR and TRIBOS_DATA_DIR).
# TRIBOS_PROJECTS_DIR=
# Run-manifest store (wins over TRIBOS_DATA_DIR; also hosts jobs/ and tool_cache/).
# TRIBOS_RUNS_DIR=
# Tool-result SQLite cache directory (wins over TRIBOS_RUNS_DIR/tool_cache).
# TRIBOS_TOOL_CACHE_DIR=
# Uploaded datasets directory (wins over TRIBOS_DATA_DIR).
# TRIBOS_UPLOAD_ROOT=

# --- Retention and maintenance ---
# Finished jobs older than this many days are purged (0 keeps them).
# TRIBOS_JOB_TTL_DAYS=30.0
# Retention sweep switch: off, auto (off under pytest) or on.
# TRIBOS_MAINTENANCE=auto
# Hours between retention sweeps.
# TRIBOS_MAINTENANCE_INTERVAL_H=6.0
# Newest run manifests kept across users (0 = unlimited).
# TRIBOS_MAX_RUNS=500
# Maximum stored run manifests kept per user (0 = unlimited).
# TRIBOS_MAX_RUNS_PER_USER=500
# Deployment salt for hashing user identifiers in exported run manifests.
# TRIBOS_USER_HASH_SALT=

# --- Authentication ---
# Allow non-loopback connections when authentication is disabled (unsafe).
# TRIBOS_ALLOW_INSECURE=false
# Static bearer tokens as comma-separated `token:user_id` pairs.
# TRIBOS_API_TOKENS=
# `disabled` runs every request as one local user (development only); otherwise bearer auth is required.
# TRIBOS_AUTH_MODE=
# Required JWT `aud` claim when set.
# TRIBOS_JWT_AUDIENCE=
# Required JWT `iss` claim when set.
# TRIBOS_JWT_ISSUER=
# HS256 secret for bearer JWTs (`sub` = user id, `exp` required).
# TRIBOS_JWT_SECRET=

# --- API server ---
# Allowed HTTP Host header values (comma-separated; defaults to loopback when auth is disabled).
# TRIBOS_ALLOWED_HOSTS=
# Comma-separated browser origins allowed by CORS (also allowed by the MCP endpoint).
# TRIBOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Seconds the upstream readiness probes of /api/health are cached.
# TRIBOS_HEALTH_CACHE_S=60.0
# Largest request body in MB (larger requests get 413).
# TRIBOS_MAX_BODY_MB=2.0
# Questions one user may have running at once (over it the request is refused).
# TRIBOS_MAX_CONCURRENT_CHATS_PER_USER=2
# Model-generated thread titles per user at once (over it a heuristic title is used).
# TRIBOS_MAX_CONCURRENT_TITLES_PER_USER=2
# Largest request body in MB for the export and report endpoints.
# TRIBOS_MAX_EXPORT_BODY_MB=16.0
# Public base URL of the API (e.g. https://tribos.example.org) used in the A2A Agent Card; default: the request's own base URL.
# TRIBOS_PUBLIC_URL=
# Seconds between keep-alive comments on chat and job event streams.
# TRIBOS_SSE_HEARTBEAT_S=15.0
# Fail startup when configuration validation reports a problem instead of only logging it.
# TRIBOS_STRICT_CONFIG=false
# Fail startup when an optional API router cannot be imported instead of disabling it.
# TRIBOS_STRICT_ROUTERS=false

# --- TRIBOS_MCP_*: MCP and A2A endpoints ---
# Seconds a blocking A2A message/send waits for its job before returning the task.
# TRIBOS_A2A_BLOCKING_TIMEOUT_S=300.0
# Extra comma-separated origins the MCP endpoint accepts besides TRIBOS_CORS_ORIGINS.
# TRIBOS_MCP_ALLOWED_ORIGINS=
# Concurrent MCP research calls per user.
# TRIBOS_MCP_MAX_CONCURRENT=2
# Seconds an MCP research call may run before it is cancelled.
# TRIBOS_MCP_RESEARCH_TIMEOUT_S=900.0
# Comma-separated registry tools exposed over MCP (default: the built-in allowlist).
# TRIBOS_MCP_TOOLS=

# --- TRIBOS_JOB_*: Background jobs ---
# Seconds a cancelled job may take to stop before it is marked cancelled anyway.
# TRIBOS_JOB_CANCEL_GRACE_S=20.0
# Progress events kept per job; older ones are dropped.
# TRIBOS_JOB_MAX_EVENTS=20000
# Background-job worker tasks.
# TRIBOS_JOB_WORKERS=2
# Queued + running background jobs per user.
# TRIBOS_MAX_JOBS_PER_USER=3

# --- Models and LLM providers ---
# Read timeout in seconds between streamed completion chunks.
# LLM_STREAM_TIMEOUT=120.0
# Wall-clock cap in seconds on one streamed completion.
# LLM_STREAM_TOTAL_TIMEOUT=1800.0
# Per-request LLM client timeout in seconds.
# LLM_TIMEOUT=60.0
# NVIDIA NIM models (default LLM provider) and the NIM structure tools.
# NVIDIA_API_KEY=
# Alternative name for NVIDIA_API_KEY (used when that one is unset).
# NVIDIA_NIM_API_KEY=
# OpenAI models; also the fallback when no NVIDIA key is set.
# OPENAI_API_KEY=
# Extra comma-separated model ids callers may select besides the built-in catalog.
# TRIBOS_ALLOWED_MODELS=
# Allow fallback to an available provider when the requested model key is unset.
# TRIBOS_LLM_FALLBACK=true
# Default model id when a request names none (the orchestrator default when unset; gpt-4o-mini for the Lumicell SCP agent).
# TRIBOS_LLM_MODEL=
# Model that writes the final answer (default: the turn's model).
# TRIBOS_SYNTHESIS_MODEL=

# --- TRIBOS_AGENT_*: Agentic runtime ---
# Seconds a plan waits for the user's approval before running as proposed.
# TRIBOS_AGENT_APPROVAL_TIMEOUT=300.0
# Seconds one agent model call (plan, critique, verdict) may take.
# TRIBOS_AGENT_CALL_TIMEOUT=180.0
# Sub-question decomposition: off, auto (complex questions only) or on (always).
# TRIBOS_AGENT_DECOMPOSE=auto
# Agent model calls kept for the final rewrite and verifier revision (0 when the call budget is below 6).
# TRIBOS_AGENT_FINAL_RESERVE_CALLS=2
# Run budget tokens kept for the final rewrite and verifier revision; optional agent work stops before them (unset = 12% of the token budget, at least 20k, at most 30%).
# TRIBOS_AGENT_FINAL_RESERVE_TOKENS=  # default: default_reserve
# Run budget: draft/critique/revise rounds.
# TRIBOS_AGENT_MAX_DRAFT_ROUNDS=2
# Run budget: agent model calls.
# TRIBOS_AGENT_MAX_LLM_CALLS=40
# Explicit per-reply output token cap for agent calls (0/unset = budget-derived only).
# TRIBOS_AGENT_MAX_OUTPUT_TOKENS=0
# Run budget: nodes in one plan.
# TRIBOS_AGENT_MAX_PLAN_NODES=12
# Run budget: replans after failed or missing evidence.
# TRIBOS_AGENT_MAX_REPLANS=1
# Run budget: wall-clock seconds (0 = no limit).
# TRIBOS_AGENT_MAX_SECONDS=0.0
# Run budget: model tokens.
# TRIBOS_AGENT_MAX_TOKENS=250000
# Run budget: tool calls.
# TRIBOS_AGENT_MAX_TOOL_CALLS=40
# Model for agentic planning/critique calls (default: the turn's model).
# TRIBOS_AGENT_MODEL=
# Output tokens admitted per agent model call; also its max_tokens, so concurrent calls cannot overshoot the budget together.
# TRIBOS_AGENT_OUTPUT_RESERVE_TOKENS=4096
# Plan-and-execute phase: off disables it.
# TRIBOS_AGENT_PLAN=auto
# Plan nodes executed in parallel.
# TRIBOS_AGENT_PLAN_CONCURRENCY=4
# Plan execution: dag (one plan, parallel nodes) or react (step-by-step tool rounds).
# TRIBOS_AGENT_PLAN_MODE=dag
# Maximum tool rounds in react plan mode.
# TRIBOS_AGENT_REACT_STEPS=4
# Keep model reasoning on for short agent calls (plans, critiques, JSON verdicts).
# TRIBOS_AGENT_THINKING=false
# Action on approval timeout: withhold_expensive (default) or reject.
# TRIBOS_APPROVAL_ON_TIMEOUT=withhold_expensive
# Seconds a tool-approval request waits for the user before it is denied.
# TRIBOS_APPROVAL_TIMEOUT_S=300.0
# Seconds a cancelled or deadline-expired model call is waited for before it is abandoned.
# TRIBOS_CANCEL_GRACE_S=2.0
# Counter-evidence search for research answers: off disables it.
# TRIBOS_COUNTER_EVIDENCE=auto
# Orchestration framework used when a request names none or an unknown one (default: auto routing for API requests; the classic pipeline for direct orchestrator calls).
# TRIBOS_DEFAULT_FRAMEWORK=
# Output tokens (reasoning included) admitted for the first draft of an agentic run and sent as its max_tokens.
# TRIBOS_FIRST_DRAFT_MAX_OUTPUT_TOKENS=16000
# Seconds between liveness re-emits of a step waiting on a long model call (0 disables).
# TRIBOS_PROGRESS_HEARTBEAT_S=5.0
# Most output tokens one answer rewrite or verifier revision may produce (never more than the run budget has left; a rewrite that would be cut off is skipped).
# TRIBOS_REWRITE_MAX_OUTPUT_TOKENS=8192
# Auto routing outcome store (default <TRIBOS_RUNS_DIR>/router, else <TRIBOS_DATA_DIR>/router, else data/router).
# TRIBOS_ROUTER_DIR=
# Auto routing outcome learning: off, auto (off under pytest) or on.
# TRIBOS_ROUTER_LEARNING=auto
# Auto routing: off scores the deterministic signals only; auto/on add the model's semantic features.
# TRIBOS_ROUTER_LLM=auto
# Auto routing: semantic feature samples averaged per question (self-consistency).
# TRIBOS_ROUTER_SAMPLES=1
# Local sentence-transformers model id for embedding-based tool retrieval (unset = lexical only).
# TRIBOS_TOOL_EMBEDDINGS=

# --- TRIBOS_NLI_*: Claim verification (NLI) ---
# Claim-vs-evidence NLI: off, auto (cross-encoder, else LLM), model (cross-encoder only) or llm.
# TRIBOS_NLI=auto
# Cross-encoder batch size.
# TRIBOS_NLI_BATCH=16
# Words per evidence window scored against a claim.
# TRIBOS_NLI_CHUNK_WORDS=120
# Contradiction probability at or above which a claim is contradicted.
# TRIBOS_NLI_CONTRADICT=0.8
# Entailment probability at or above which a claim is supported.
# TRIBOS_NLI_ENTAIL=0.5
# Claims per LLM NLI call.
# TRIBOS_NLI_LLM_BATCH=4
# LLM NLI calls per run (hard ceiling 12).
# TRIBOS_NLI_MAX_LLM_CALLS=12
# Hugging Face cross-encoder used for NLI.
# TRIBOS_NLI_MODEL=cross-encoder/nli-deberta-v3-base
# Entailment probability below which a claim is unsupported.
# TRIBOS_NLI_UNSUPPORTED=0.15

# --- TRIBOS_CONFIDENCE_*: Confidence calibration ---
# JSON file with a fitted temperature, conformal threshold and feature weights.
# TRIBOS_CONFIDENCE_CALIBRATION=
# Model-elicited confidence for claims: off disables it.
# TRIBOS_CONFIDENCE_ELICIT=auto
# Confidence temperature override (positive; clamped to 0.05-20).
# TRIBOS_CONFIDENCE_T=

# --- Query planning and synthesis ---
# Seconds for query normalization when the caller keeps the 3.5 s default.
# TRIBOS_NORMALIZER_BUDGET_S=
# LLM query planner: off, auto (when heuristics are unsure) or always.
# TRIBOS_PLANNER=auto
# Skip the entity resolver in query normalization (1/true/yes).
# TRIBOS_RESOLVER_DISABLED=false
# Seconds the pipeline waits for the LLM search plan before using the heuristic one.
# TRIBOS_SEARCH_PLAN_WAIT_S=6.0
# Stream raw model reasoning to the client (it is not checked by the verifier).
# TRIBOS_SHOW_REASONING=false

# --- Tool reliability and cache ---
# Seconds an open circuit breaker waits before a trial call.
# TRIBOS_BREAKER_COOLDOWN_S=60.0
# Consecutive failures that open an adapter's circuit breaker.
# TRIBOS_BREAKER_THRESHOLD=5
# Thread pool size for CPU-bound native tools.
# TRIBOS_NATIVE_WORKERS=4
# Thread pool size for synchronous networked tools.
# TRIBOS_NETWORK_WORKERS=16
# Tool retry/breaker/cache policies: off, auto (off under pytest) or on.
# TRIBOS_RELIABILITY=auto
# Tool-result cache (needs TRIBOS_RELIABILITY): off, auto (off under pytest) or on.
# TRIBOS_TOOL_CACHE=auto
# Overrides the per-adapter tool-cache TTL (seconds).
# TRIBOS_TOOL_CACHE_TTL_S=
# Retries of a networked tool after a transient failure.
# TRIBOS_TOOL_RETRIES=2

# --- Web search ---
# Tavily web search (first provider when set).
# TAVILY_API_KEY=
# Base URL of a SearXNG instance with the JSON format enabled (used after Tavily).
# TRIBOS_SEARXNG_URL=

# --- Data sources ---
# NCBI E-utilities key (raises the rate limit from 3 to 10 requests/s).
# NCBI_API_KEY=
# Optional NASA ADS Bearer API token for astrophysics literature search in Archivon.
# TRIBOS_ADS_API_TOKEN=
# Polite-pool contact e-mail sent in User-Agent headers for arXiv, Crossref, OpenAlex, and Wikipedia.
# TRIBOS_CONTACT_EMAIL=contact@tribos.science
# Contact e-mail for the Crossref polite pool (citation integrity checks).
# TRIBOS_CROSSREF_MAILTO=
# Optional Materials Project API v2 key for live crystalline/electronic material queries in Physis.
# TRIBOS_MP_API_KEY=
# Optional OpenAlex API key for polite/premium pool requests in Archivon.
# TRIBOS_OPENALEX_API_KEY=
# Live source-version probes for run manifests: off, auto (off under pytest) or on.
# TRIBOS_PROVENANCE_PROBES=auto
# Optional Semantic Scholar API key for higher rate limits in Archivon.
# TRIBOS_S2_API_KEY=
# Optional Wolfram|Alpha LLM API AppID for Physis external reference queries.
# TRIBOS_WOLFRAM_APPID=

# --- TRIBOS_UPLOAD_*: Uploads and datasets ---
# Uploaded datasets kept per user.
# TRIBOS_UPLOAD_MAX_DATASETS=50
# Largest table (CSV/TSV) upload in MB.
# TRIBOS_UPLOAD_MAX_MB_CSV=100.0
# Deprecated: fallback for TRIBOS_UPLOAD_MAX_MB_HDF5.
# TRIBOS_UPLOAD_MAX_MB_H5AD=500.0
# Largest HDF5 (.h5/.hdf5) upload in MB.
# TRIBOS_UPLOAD_MAX_MB_HDF5=500.0
# Largest MATLAB (.mat) upload in MB.
# TRIBOS_UPLOAD_MAX_MB_MAT=100.0
# Largest paper (.pdf) upload in MB.
# TRIBOS_UPLOAD_MAX_MB_PDF=25.0
# Most pages an uploaded paper may have.
# TRIBOS_UPLOAD_MAX_PDF_PAGES=300
# Total upload storage per user in MB.
# TRIBOS_UPLOAD_MAX_TOTAL_MB=2048.0

# --- Simulation and single-cell analysis ---
# Nested grids of the PDE mesh-convergence study.
# TRIBOS_PDE_MAX_CONVERGENCE_LEVELS=3
# Largest number of grid points in a 1D PDE solve.
# TRIBOS_PDE_MAX_GRID_1D=20000
# Largest number of grid points in a 2D PDE solve (80 x 80).
# TRIBOS_PDE_MAX_GRID_2D=6400
# Wall-clock limit of one PDE solve, convergence study included.
# TRIBOS_PDE_MAX_SECONDS=20.0
# Snapshots one PDE solve returns.
# TRIBOS_PDE_MAX_SNAPSHOTS=25
# Interactive simulation calls one user may have running at once.
# TRIBOS_SIMULATE_MAX_CONCURRENT=2
# Interactive simulation calls one user may make per minute.
# TRIBOS_SIMULATE_RATE_PER_MIN=60
# Seconds one interactive simulate, bifurcation or vector-field call may run.
# TRIBOS_SIMULATE_TIMEOUT_S=10.0

# --- TRIBOS_SANDBOX_*: Code sandbox ---
# Code-execution sandbox tool; on by default, off/0/false/no disables it.
# TRIBOS_SANDBOX=true
# Memory limit of one sandboxed execution in MB.
# TRIBOS_SANDBOX_MEMORY_MB=2048
# Seconds one sandboxed execution may run.
# TRIBOS_SANDBOX_TIMEOUT_S=60

# --- TRIBOS_MATH_*: Mathematics agent ---
# Run the verified mathematics agent (bounded ReAct loop over the Axiom tools with an independent verifier) on mathematical questions.
# TRIBOS_MATH_AGENT=true
# Local repairs of one failed step before the agent switches strategy.
# TRIBOS_MATH_AGENT_MAX_REPAIRS=4
# Tool calls one mathematics-agent run may make.
# TRIBOS_MATH_AGENT_MAX_STEPS=12
# Append every mathematics-agent trajectory here as JSONL (tool calls, observations, verification labels) for evaluation and fine-tuning data.
# TRIBOS_MATH_TRAJECTORY_DIR=
# SageMath executable, or `wsl:<wsl.exe arguments>` to run it inside WSL; discovered on PATH and in WSL when unset.
# TRIBOS_SAGEMATH_PATH=

# --- TRIBOS_VISION_*: Image input (OCR and vision) ---
# Accept images attached to questions (POST /api/vision/read); they are read into text before the question is solved.
# TRIBOS_VISION=true
# Images one question may carry.
# TRIBOS_VISION_MAX_IMAGES=4
# Largest image upload in MB.
# TRIBOS_VISION_MAX_MB=10
# Pages of an attached PDF that are read (each like one image).
# TRIBOS_VISION_MAX_PAGES=4
# NVIDIA NIM vision model for `nim` (must be in the allowed model list).
# TRIBOS_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Load Indra OCR's math models so formulas are read as LaTeX (about 60% slower OCR on math lines).
# TRIBOS_VISION_OCR_MATH=true
# Ollama vision model for `ollama` (e.g. qwen2.5vl:7b); the first installed vision-family model when unset.
# TRIBOS_VISION_OLLAMA_MODEL=
# Base URL of the local Ollama server.
# TRIBOS_VISION_OLLAMA_URL=http://127.0.0.1:11434
# Vision model that corrects the OCR draft: `nim` (NVIDIA NIM, TRIBOS_VISION_MODEL), `ollama` (a local model through Ollama), or `ocr` (Indra OCR only; the image never leaves this machine).
# TRIBOS_VISION_PROVIDER=nim
# Seconds one vision-model transcription may take (CPU inference of a 7B model can need minutes).
# TRIBOS_VISION_TIMEOUT_S=300

# --- TRIBOS_EVAL_*: Evaluations ---
# Hugging Face user access token for gated benchmark downloads (GPQA Diamond).
# HF_TOKEN=
# Store full normalised prompts in recorded eval cassettes (easier miss diagnosis, larger files).
# TRIBOS_CASSETTE_PROMPTS=false
# Downloaded benchmark datasets cache (default ~/.cache/tribos/evals).
# TRIBOS_EVAL_CACHE=
# Model id of the evaluation judge; also added to the models callers may select.
# TRIBOS_EVAL_JUDGE_MODEL=
# Bearer token the eval runner sends to a remote Tribos API.
# TRIBOS_EVAL_TOKEN=

# --- Testing ---
# Set by pytest; `auto` switches and default stores treat its presence as a test run. Never set it yourself.
# PYTEST_CURRENT_TEST=
# Load the workspace `.env` when the API module is imported; tests/conftest.py sets 0 so a developer `.env` never reaches pytest.
# TRIBOS_LOAD_DOTENV=true

# --- Unregistered ---
# TRIBOS_FORMAL=
# TRIBOS_FORMAL_MAX_REPAIRS=
# TRIBOS_FORMAL_TIMEOUT_S=
# TRIBOS_LEAN_PATH=
# TRIBOS_LEAN_PROJECT=
